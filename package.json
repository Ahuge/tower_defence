{
  "name": "tower_defence",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:native": "tsc && cross-env-shell VITE_BASE_PATH=./ vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron electron/main.cjs",
    "electron:build": "npm run build:native && electron-builder --config electron-builder.yml",
    "electron:build:win": "npm run build:native && electron-builder --config electron-builder.yml --win",
    "electron:build:mac": "npm run build:native && electron-builder --config electron-builder.yml --mac",
    "electron:build:linux": "npm run build:native && electron-builder --config electron-builder.yml --linux",
    "postinstall": "patch-package",
    "assets:generate": "node scripts/generate-native-assets.js && capacitor-assets generate --android --ios",
    "cap:sync": "npm run build:native && cap sync",
    "cap:sync:android": "npm run build:native && cap sync android",
    "cap:sync:ios": "npm run build:native && cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "npm run build:native && cap run android",
    "cap:run:ios": "npm run build:native && cap run ios",
    "android:debug": "npm run cap:sync:android && cd android && ./gradlew assembleDebug",
    "android:release:apk": "npm run cap:sync:android && cd android && ./gradlew assembleRelease",
    "android:release:aab": "npm run cap:sync:android && cd android && ./gradlew bundleRelease",
    "screenshots": "node scripts/capture-store-screenshots.mjs",
    "achievements:build": "node scripts/generate-achievement-icons.js && node scripts/build-achievements-zip.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@osmanraifgunes/capacitor-game-connect": "^8.1.0",
    "cordova-plugin-purchase": "^13.15.2",
    "phaser": "^4.0.0",
    "preact": "^10.29.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.4",
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "jszip": "^3.10.1",
    "marked": "^18.0.2",
    "patch-package": "^8.0.1",
    "puppeteer": "^24.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.19.2",
    "vitest": "^4.1.4"
  }
}
