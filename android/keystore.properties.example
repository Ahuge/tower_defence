# Factions release-signing configuration.
#
# Copy this file to `keystore.properties` (same dir) and fill in the
# real values. `keystore.properties` is gitignored — the real file
# never goes into version control.
#
# Reference values live in your password manager (same entry as the
# keystore file itself).
#
# When keystore.properties exists, `./gradlew assembleRelease` and
# `./gradlew bundleRelease` sign with the release key automatically.
# When it's missing, those tasks produce unsigned artifacts (debug
# builds are unaffected — they use the Android default debug key).

storeFile=/home/alex/factions-release.keystore
storePassword=REDACTED-SEE-PASSWORD-MANAGER
keyAlias=factions
keyPassword=REDACTED-SEE-PASSWORD-MANAGER
