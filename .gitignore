# Capacitor — build artefacts + sync'd web bundle. The native
# projects themselves (android/, ios/) are committed; these
# subpaths are regenerated each `cap sync`.
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/keystore.properties
android/app/release/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

ios/App/build/
ios/App/Pods/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/capacitor-cordova-ios-plugins/
ios/DerivedData/

harness-results.json
harness-results.md
harness-report.md
harness-progress.jsonl
harness-runs/
/brain-search/
/ml/training-data/
/ml/__pycache__/
/ml/**/__pycache__/
/ml/.venv/
# /ml/captured/ is NOT ignored — those are committed human-played
# JSONL files (hand-collected positive examples for hard cells).
# BC + PPO rollouts (large generated JSONL training data). Each
# run lives under rollouts/{purpose}/{run_id}/. Like
# ml/training-data, these regenerate from a seed and aren't worth
# committing.
/rollouts/

# TensorBoard / training run logs. Regenerated per-run.
/runs/

# Captured match traces (JSON action sequences) + rendered media.
# Each trace + .webm regenerates from a (brain, faction, seed,
# difficulty, waves) tuple, so committing them adds noise.
/traces/
/media/

# Per-run model artifacts: BC + PPO checkpoints stamped with run
# IDs (e.g. models/bc-smoke.*, models/bc-2026-05-26-*.onnx). The
# canonical LearningBrain xgboost model (`brain-q-model.json`) IS
# committed — anything else under models/ is regenerable training
# output.
/models/bc-*
/models/ppo-*
/models/runs-*
